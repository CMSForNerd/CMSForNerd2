---
// src/components/Search.astro
const base = import.meta.env.BASE_URL;
---

<div class="search-container">
  <link href={`${base}pagefind/pagefind-component-ui.css`} rel="stylesheet" />
  <div id="pagefind-search">
    <pagefind-input placeholder="Search documentation and pages..."></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>
</div>

<script is:inline>
  function initPagefindComponentUI() {
    if (!customElements.get('pagefind-input')) {
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';
      const script = document.createElement('script');
      script.type = 'module';
      script.src = `${base}pagefind/pagefind-component-ui.js`;
      document.head.appendChild(script);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagefindComponentUI);
  } else {
    initPagefindComponentUI();
  }
</script>

<style>
  .search-container {
    margin: 1.5rem 0;
    padding: 1rem;
    background-color: var(--lab-card-bg, #f8f9fa);
    border: 1px solid var(--lab-border, #dee2e6);
    border-radius: 8px;
  }
</style>
